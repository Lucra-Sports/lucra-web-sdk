{
  "compilerOptions": {
    // Latest type definitions, but emit syntax old bundlers can still parse.
    // `lib` stays ESNext so type availability is unchanged. `target` is ES2019
    // because webpack 4 parses with acorn 6 (ES2019 ceiling) and chokes on the
    // ES2020+ syntax a higher target emits: `?.`, `??`, numeric separators, and
    // native class fields. Downleveling those needs no runtime polyfill.
    "lib": ["ESNext", "DOM"],
    "target": "ES2019",
    "module": "ESNext",
    "moduleDetection": "force",
    "jsx": "react-jsx",
    "allowJs": true,

    // Bundler mode
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "verbatimModuleSyntax": true,
    "noEmit": false,
    "outDir": "dist",
    "declaration": true,

    // Best practices
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,

    // Some stricter flags (disabled by default)
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noPropertyAccessFromIndexSignature": false
  },
  "exclude": ["dist"],
  "files": ["index.ts", "types/types.ts", "base.ts", "v1.ts", "dialog.ts", "popup.ts", "version.ts"]
}
