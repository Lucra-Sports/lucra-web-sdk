{
  "name": "lucra-web-sdk",
  "version": "1.14.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types/types.d.ts",
      "import": "./dist/types/types.js",
      "default": "./dist/types/types.js"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bunx tsc --project tsconfig.json",
    "test": "bun test",
    "docs:check": "bun scripts/check-docs.ts",
    "evals": "claude plugin eval . --trust-plugin --scaffold --allow-tools Write Edit --model sonnet -j 4 --no-publish --max-cost-usd 5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript-docs-verifier": "^3.0.2"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  }
}
